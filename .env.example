# ===== API CONFIGURATION =====
CLINVAR_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
PHARMGKB_BASE_URL=https://api.clinpgx.org/v1
NCBI_API_KEY=
API_VERSION=2.0.0

# ===== REQUEST CONFIGURATION =====
API_TIMEOUT_MS=30000
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY_MS=1000

# ===== CACHE CONFIGURATION =====
ENABLE_CACHE=true
CACHE_TTL_STATIC_HOURS=24
CACHE_TTL_DYNAMIC_MINUTES=30

# ===== HTTP / SECURITY =====
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=127.0.0.1,localhost

# ===== OAUTH (required for remote HTTP in production) =====
OAUTH_ENABLED=false
OAUTH_REQUIRED=false
OAUTH_ISSUER=
OAUTH_AUDIENCE=
OAUTH_JWKS_URI=
OAUTH_AUTHORIZATION_ENDPOINT=
OAUTH_TOKEN_ENDPOINT=
OAUTH_RESOURCE_SERVER_URL=http://localhost:3000
OAUTH_SCOPES=genomics:read,genomics:tools
OAUTH_DEV_TOKEN=

# ===== MCP SERVER CONFIGURATION =====
MCP_SERVER_NAME=genomics-clinical
MCP_SERVER_VERSION=2.0.0

# ===== ERROR HANDLING & LOGGING =====
LOG_LEVEL=info
VERBOSE_LOGGING=false

# ===== RATE LIMITING =====
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=10

# ===== DEBUG AND DEVELOPMENT =====
DEBUG_MODE=false
MOCK_API_RESPONSES=false
